[Unit]
Description=srv guest tailscale bootstrap
After=local-fs.target systemd-resolved.service tailscaled.service
Wants=systemd-resolved.service tailscaled.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/srv/bootstrap.sh
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
