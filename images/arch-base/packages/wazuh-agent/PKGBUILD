# Source-built Wazuh agent for the srv Arch guest image.
#
# This is not the AUR wazuh-agent recipe: nothing is repacked from upstream
# RPMs, every source is pinned to an immutable commit or a SHA-256, and the
# upstream tag signature is checked against a pinned key.
#
# Provenance of the Wazuh source (checked 2026-11-19):
#   refs/tags/v4.14.9 is annotated tag object
#     baad447a9fbed34f9dd3d23d5c916247da005ac6
#   which peels to commit
#     bed556db3f4f535cb3a585f3d9e7f35a6acf0f58
#   It is signed by Jose Luis Carreras Marin <jose.carreras@wazuh.com>, RSA key
#     19AFF1D3313289B5CA858E107EB06E5961B8E83E
#   `git verify-tag v4.14.9` reports a good signature with that key, and the
#   GitHub API reports both the tag and the commit as verified. The public key in
#   keys/pgp/ was exported (export-minimal) from https://github.com/jotacarma90.gpg,
#   the GitHub account that authors Wazuh commits as jose.carreras@wazuh.com.
#   GitHub publishes the release "Wazuh v4.14.9" (not a prerelease, published
#   2026-10-15). VERSION.json at the tag still says stage "rc2", as upstream ships it.
#
# Third-party sources follow upstream's Makefile at the pinned commit
# (DEPS_VERSION = 55, RESOURCES_URL https://packages.wazuh.com/deps/55). Wazuh
# does not sign those tarballs. Their SHA-256 sums below were recorded on
# 2026-11-19 (trust on first use). Upstream's libbpf-bootstrap CMake project
# would otherwise clone libbpf and bpftool by tag, clone vmlinux.h from a
# floating branch, and download modern.bpf.c from wazuh v4.12.0 at configure
# time. prepare() pins all of these and uses the modern.bpf.c in the pinned tree,
# whose event layout matches the userspace code in this tree; the v4.12.0 file
# does not (it lacks the euid and login_uid fields).
#
# Build this in a clean Arch environment (pkgctl build, or the rootless podman
# recipe in images/arch-base/README.md). The resulting package is not signed:
# images/arch-base/build.sh pins its SHA-256 instead.

pkgname=wazuh-agent
pkgver=4.14.9
pkgrel=1
pkgdesc='Wazuh host security agent (built from source for srv guests)'
arch=(x86_64)
url='https://github.com/wazuh/wazuh'
license=(GPL-2.0-only)
depends=(glibc libelf zlib systemd)
makedepends=(git cmake make gcc clang llvm python libtool autoconf automake pkgconf patchelf)
optdepends=('python: cloud and docker wodles')
# Upstream's build manages its own optimisation flags; build() pins the
# hardening flags instead of inheriting the builder's makepkg.conf.
options=(!buildflags !lto !debug emptydirs)
backup=(var/ossec/etc/local_internal_options.conf)

_tag=v4.14.9
_commit=bed556db3f4f535cb3a585f3d9e7f35a6acf0f58
# Gitlink recorded at src/shared_modules/http-request in the pinned tree.
_http_request_commit=cd50797cfe03c27f3759bdc243fecca6f7535d35
# libbpf-bootstrap's CMakeLists.txt names libbpf v1.7.0 and bpftool v7.7.0.
_libbpf_commit=f5dcbae736e5d7f83a35718e01be1a8e3010fa39   # v1.7.0 (lightweight tag)
_bpftool_commit=4222ef1c8cdb0a1ea03c7a8c650ec334b782902d  # v7.7.0 (tag d245d44b...)
_vmlinux_h_commit=c32912840154a82205530cd6d498b346ac73a6d1 # main on 2026-11-19
_deps_version=55
_deps=(
	cJSON curl libdb libffi libyaml openssl procps sqlite zlib audit-userspace
	msgpack bzip2 nlohmann googletest libpcre2 libplist pacman libarchive popt
	lua rpm rocksdb lzma cpp-httplib benchmark libbpf-bootstrap dbus
)

source=(
	"wazuh::git+https://github.com/wazuh/wazuh.git#tag=${_tag}?signed"
	"wazuh-http-request::git+https://github.com/wazuh/wazuh-http-request.git#commit=${_http_request_commit}"
	"libbpf::git+https://github.com/libbpf/libbpf.git#commit=${_libbpf_commit}"
	"bpftool::git+https://github.com/libbpf/bpftool.git#commit=${_bpftool_commit}"
	"vmlinux.h::git+https://github.com/libbpf/vmlinux.h.git#commit=${_vmlinux_h_commit}"
	srv-install-shim.sh
	wazuh-agent.sysusers
)
sha256sums=(SKIP SKIP SKIP SKIP SKIP
	'a82538a9b184465d9cac7d297773275ed207decb79ad88feef88a81bc189e403'
	'2892dfa168bba13057d911ca7a4049bac49e9369388a14018d43765bf7697083')
noextract=()
for _dep in "${_deps[@]}"; do
	source+=("wazuh-deps-${_deps_version}-${_dep}.tar.gz::https://packages.wazuh.com/deps/${_deps_version}/libraries/sources/${_dep}.tar.gz")
	noextract+=("wazuh-deps-${_deps_version}-${_dep}.tar.gz")
done
unset _dep
# Same order as _deps.
