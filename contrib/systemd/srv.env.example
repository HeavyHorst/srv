# Copy this file to /etc/srv/srv.env and fill in the required values.
#
# Required for the control-plane node join. After the first successful start,
# tsnet state under SRV_DATA_DIR/state/tsnet usually persists the node identity,
# but keeping TS_AUTHKEY configured is the simplest setup.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxx

# Required for minting one-off guest auth keys during `ssh srv new NAME`.
TS_CLIENT_ID=your-oauth-client-id
TS_CLIENT_SECRET=your-oauth-client-secret
TS_TAILNET=your-tailnet.ts.net

# Core srv settings.
SRV_HOSTNAME=srv
SRV_LISTEN_ADDR=:22
# Must be a btrfs subvolume root for all VMs and Orbs. Install btrfs-progs and
# mount with user_subvol_rm_allowed for deletion of service-owned subvolumes.
# No new capabilities are needed by the main srv process.
SRV_DATA_DIR=/var/lib/srv
SRV_NET_HELPER_SOCKET=/run/srv/net-helper.sock
SRV_VM_RUNNER_SOCKET=/run/srv-vm-runner/vm-runner.sock
# The installer downloads the official static Firecracker release pair here by default.
SRV_FIRECRACKER_BIN=/usr/local/bin/firecracker
SRV_JAILER_BIN=/usr/local/bin/jailer
# Orb runtime and jail directories must share a subvolume, not just a filesystem:
# only the Orb socket is hard-linked; the runner bind-mounts boot artifacts/logs.
# SRV_JAILER_BASE_DIR=/var/lib/srv/jailer
# SRV_JAILER_USER=srv-vm
# SRV_JAILER_GROUP=srv

# Base guest artifacts.
SRV_BASE_KERNEL=/var/lib/srv/images/arch-base/vmlinux
# Every base rootfs image must be on the same btrfs filesystem as SRV_DATA_DIR.
SRV_BASE_ROOTFS=/var/lib/srv/images/arch-base/rootfs-base.img
# SRV_BASE_INITRD=
# Optional JSON catalog for additional guest images, selected with new --image NAME.
# SRV_IMAGES_FILE=/etc/srv/images.json
# Root-owned, non-service-writable tree containing allowed kernel/initrd files.
# SRV_IMAGES_DIR=/var/lib/srv/images

# Required so minted guest keys carry an allowed tag.
SRV_GUEST_AUTH_TAGS=tag:microvm
# Optional trusted Tailscale-login-to-tag mappings that replace the defaults at VM creation.
# SRV_GUEST_USER_AUTH_TAGS=rene.michaelis@antares.net=tag:rene

# Optional controls.
# SRV_ALLOWED_USERS=alice@example.com,bob@example.com
# SRV_ADMIN_USERS=ops@example.com
# Stable Tailscale node IDs, not hostnames; permits these frontends to assert user identities.
# SRV_TRUSTED_FRONTENDS=nYourFrontendNodeID
# SRV_ADVERTISE_TAGS=tag:microvm-control
# SRV_OUTBOUND_IFACE=eth0
# SRV_VM_NETWORK_CIDR=172.28.0.0/16
# SRV_VM_DNS=1.1.1.1,1.0.0.1
# SRV_GUEST_AUTH_EXPIRY=15m
# SRV_GUEST_READY_TIMEOUT=2m
# SRV_VM_VCPUS=1
# SRV_VM_MEMORY_MIB=1024
# SRV_VM_PIDS_MAX=512
# SRV_LOG_LEVEL=info
# SRV_ZEN_API_KEY=
# SRV_ZEN_BASE_URL=https://opencode.ai/zen
# SRV_ZEN_GATEWAY_PORT=11434
# SRV_INTEGRATION_GATEWAY_PORT=11435
# SRV_AMP_CONNECT_GATEWAY_PORT=3128
# SRV_SECRET_OPENAI_PROD=

# Optional btrfs-over-SSH cold storage (disabled unless a host is configured).
# Install srv-cold-store as a restricted root SSH forced command on the remote.
# Keep credentials and all parent directories root-owned, not group/world-writable.
# SRV_COLD_STORAGE_HOST=storage.example.net
# SRV_COLD_STORAGE_KEY=/etc/srv/cold-storage/id_ed25519
# SRV_COLD_STORAGE_KNOWN_HOSTS=/etc/srv/cold-storage/known_hosts
# SRV_COLD_STORAGE_AFTER_STOP=true

# Native frontend migration (explicit trust of all participating Btrfs senders).
# Existing private root-owned directory on the instances' Btrfs filesystem;
# every ancestor must also be root-owned and not group/world-writable.
# Use a separate store, not the srv-writable tree or the remote offload store.
# Use consistent mount paths with SRV_DATA_DIR, not mixed bind-mount aliases;
# see docs/getting-started/multi-host.md#enable-native-transfer.
# SRV_MIGRATION_STORE=/btrfs/private/srv-migration

# Alternate control-plane endpoints, for example when using Headscale.
# TS_CONTROL_URL=
# TS_API_BASE_URL=
# SRV_GUEST_TAILSCALE_CONTROL_URL=

# Extra guest kernel arguments appended to the Firecracker boot line.
# SRV_EXTRA_KERNEL_ARGS=
