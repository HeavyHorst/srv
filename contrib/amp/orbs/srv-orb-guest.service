[Unit]
Description=Host-only Orb bootstrap transport
After=network.target systemd-resolved.service
Requires=systemd-resolved.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=/usr/bin/python3 /usr/local/lib/srv/orb-guest.py --network
ExecStart=/usr/bin/python3 /usr/local/lib/srv/orb-guest.py
Restart=on-failure
RestartSec=1
UMask=0077
LimitCORE=0
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
