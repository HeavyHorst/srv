[Unit]
Description=Retire old srv Orb project templates
After=network-online.target srv-orbs.service
Wants=network-online.target

[Service]
Type=oneshot
User=srv-orbs
Group=srv-orbs
StateDirectory=srv-orbs
StateDirectoryMode=0700
Environment=HOME=/var/lib/srv-orbs
EnvironmentFile=/etc/srv-orbs.env
UnsetEnvironment=AMP_ORB_PROVIDER_TOKEN
ExecStart=/usr/local/bin/srv-orb-dispatch snapshot-gc --auto
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
