validpgpkeys=(19AFF1D3313289B5CA858E107EB06E5961B8E83E) # Jose Luis Carreras Marin (Wazuh)

_require_head() {
	local dir="$1" want="$2" got
	got="$(git -C "${dir}" rev-parse 'HEAD^{commit}')"
	if [[ "${got}" != "${want}" ]]; then
		echo "${dir} is at ${got}, expected pinned commit ${want}" >&2
		return 1
	fi
}

prepare() {
	cd "${srcdir}/wazuh"
	# The tag is mutable upstream; the commit is what was reviewed.
	_require_head . "${_commit}"
	[[ "$(git rev-parse "refs/tags/${_tag}^{commit}")" == "${_commit}" ]]

	git submodule init src/shared_modules/http-request
	git config submodule.src/shared_modules/http-request.url "${srcdir}/wazuh-http-request"
	git -c protocol.file.allow=always submodule update src/shared_modules/http-request
	_require_head src/shared_modules/http-request "${_http_request_commit}"

	local dep
	install -d src/external
	for dep in "${_deps[@]}"; do
		bsdtar -xf "${srcdir}/wazuh-deps-${_deps_version}-${dep}.tar.gz" -C src/external
		[[ -d "src/external/${dep}" ]]
	done

	# Feed libbpf-bootstrap's ExternalProjects from the pinned checkouts rather
	# than letting CMake clone or download anything at configure time.
	local lbb=src/external/libbpf-bootstrap
	cp -a "${srcdir}/libbpf" "${lbb}/libbpf"
	cp -a "${srcdir}/vmlinux.h" "${lbb}/vmlinux.h"
	cp -a "${srcdir}/bpftool" "${lbb}/bpftool"
	git -C "${lbb}/bpftool" submodule init libbpf
	git -C "${lbb}/bpftool" config submodule.libbpf.url "${srcdir}/libbpf"
	git -C "${lbb}/bpftool" -c protocol.file.allow=always submodule update libbpf
	_require_head "${lbb}/bpftool/libbpf" "${_libbpf_commit}"
	install -d "${lbb}/src"
	install -m 0644 src/syscheckd/src/ebpf/src/modern.bpf.c "${lbb}/src/modern.bpf.c"
	sed -i \
		-e 's|^  GIT_REPOSITORY .*|  DOWNLOAD_COMMAND ""|' \
		-e '/^  GIT_TAG /d' \
		-e '/^file(DOWNLOAD /d' \
		"${lbb}/CMakeLists.txt"
	if grep -Eq 'GIT_REPOSITORY|GIT_TAG|file\(DOWNLOAD' "${lbb}/CMakeLists.txt"; then
		echo "libbpf-bootstrap still fetches sources at build time" >&2
		return 1
	fi
	# The project also compiles modern.bpf.c with the host C compiler into an
	# unused "modern" library, which only builds under pre-C23, pre-GCC-14
	# defaults. The shipped modern.bpf.o comes from clang and is unaffected.
	printf 'target_compile_options(modern PRIVATE -std=gnu17 -Wno-error=implicit-function-declaration -Wno-error=int-conversion -Wno-error=incompatible-pointer-types)\n' \
		>>"${lbb}/CMakeLists.txt"
	# Keep build paths out of modern.bpf.o's BTF line information.
	[[ "$(grep -c -- '-g -O2 -target bpf' "${lbb}/tools/cmake/FindBpfObject.cmake")" == 1 ]]
	sed -i "s|-g -O2 -target bpf|-g -O2 -ffile-prefix-map=${srcdir}=/usr/src/debug/${pkgname} -target bpf|" \
		"${lbb}/tools/cmake/FindBpfObject.cmake"

	# Packaging must not touch the build host: accounts come from sysusers.d,
	# the unit is installed by package(), and nothing is enabled or started.
	printf '#!/bin/sh\nexit 0\n' >src/init/adduser.sh
	[[ "$(grep -c '^    runInit \$INSTYPE \${update_only}$' install.sh)" == 1 ]]
	sed -i 's|^    runInit \$INSTYPE \${update_only}$|    : # runInit disabled by srv PKGBUILD|' install.sh
}

build() {
	cd "${srcdir}/wazuh/src"
	# The pinned tree and its vendored libraries (libdb 18.1 and others) predate
	# C23, which GCC 15+ uses by default; gnu17 keeps their prototypes valid.
	local cflags="-O2 -pipe -fno-plt -fexceptions -fstack-protector-strong -fstack-clash-protection -fcf-protection -Wp,-D_FORTIFY_SOURCE=2 -ffile-prefix-map=${srcdir}=/usr/src/debug/${pkgname}"
	export CFLAGS="${cflags} -std=gnu17"
	export CXXFLAGS="${cflags} -Wp,-D_GLIBCXX_ASSERTIONS"
	export LDFLAGS='-Wl,-O1 -Wl,--sort-common -Wl,--as-needed -Wl,-z,relro -Wl,-z,now'
	# Vendored configure scripts probe for optional system libraries that the
	# agent does not bundle; keep them off so the result does not depend on
	# what the build host has installed.
	export ac_cv_lib_rtmp_RTMP_Init=no ac_cv_header_librtmp_rtmp_h=no ac_cv_lib_md_MD5Init=no
	local make_args=(TARGET=agent INSTALLDIR=/var/ossec EXTERNAL_SRC_ONLY=yes USE_SELINUX=no DEBUG=no)
	# libbpf-bootstrap's CMake project races under make -j (its ExternalProject
	# build steps run twice concurrently and the skeleton is generated before
	# bpftool exists), so build it serially first.
	make -j1 "${make_args[@]}" external/libbpf-bootstrap/build/modern.bpf.o
	# data_provider needs libdb's generated db.h, but with locally built
	# external sources no agent target depends on libdb.
	make -j"$(nproc)" "${make_args[@]}" external/libdb/build_unix/.libs/libdb-18.1.a
	make -j"$(nproc)" "${make_args[@]}" build
}

package() {
	cd "${srcdir}/wazuh"
	local shim="${srcdir}/srv-shim" log="${srcdir}/ownership.log" tool
	# Upstream install.sh installs straight to INSTALLDIR as root with named
	# owners. The shim keeps it inside ${pkgdir} and records the owners, which
	# systemd-tmpfiles applies once sysusers has created the wazuh account.
	rm -rf "${shim}"
	install -d "${shim}"
	for tool in install chown chgrp; do
		ln -s "${srcdir}/srv-install-shim.sh" "${shim}/${tool}"
	done
	: >"${log}"

	cat >etc/preloaded-vars.conf <<EOF
USER_LANGUAGE="en"
USER_NO_STOP="y"
USER_INSTALL_TYPE="agent"
USER_DIR="${pkgdir}/var/ossec"
USER_DELETE_DIR="y"
USER_ENABLE_ACTIVE_RESPONSE="n"
USER_ENABLE_SYSCHECK="y"
USER_ENABLE_ROOTCHECK="y"
USER_ENABLE_OPENSCAP="n"
USER_ENABLE_SYSCOLLECTOR="y"
USER_ENABLE_CISCAT="n"
USER_UPDATE="n"
USER_AGENT_SERVER_IP="MANAGER_IP"
USER_CA_STORE="/path/to/my_cert.pem"
USER_AUTO_START="n"
EOF
	PATH="${shim}:${PATH}" SRV_PKGDIR="${pkgdir}" SRV_OWNERSHIP_LOG="${log}" \
		./install.sh binary-install

	local root="${pkgdir}/var/ossec"
	# Per-agent identity is never packaged: srv-wazuh-enroll creates it from
	# a controller-delivered key, and pacman upgrades must not replace it.
	rm -f "${root}/etc/client.keys"
	# install.sh copies the build host's /etc/localtime; guests run in UTC.
	install -m 0640 /usr/share/zoneinfo/UTC "${root}/etc/localtime"
	# CMake leaves build-tree RUNPATHs in the shared modules. On a guest those
	# directories do not exist and must never be searched: point every RUNPATH
	# at the package's own lib directory instead.
	local elf
	while IFS= read -r -d '' elf; do
		[[ -n "$(patchelf --print-rpath "${elf}" 2>/dev/null)" ]] || continue
		case "${elf#"${root}/"}" in
		lib/*) patchelf --set-rpath '$ORIGIN' "${elf}" ;;
		bin/*) patchelf --set-rpath '$ORIGIN/../lib' "${elf}" ;;
		active-response/bin/*) patchelf --set-rpath '$ORIGIN/../../lib' "${elf}" ;;
		*)
			echo "unexpected RUNPATH in ${elf}" >&2
			return 1
			;;
		esac
	done < <(find "${root}" -type f -print0)
	# install.sh writes INSTALLDIR into generated configs; it is ${pkgdir} here.
	grep -rlIF -- "${pkgdir}" "${pkgdir}" | xargs -r sed -i "s|${pkgdir}||g"
	# Binaries still name build directories in strings (vendored D-Bus's
	# configured prefix, OpenSSL's compiler line); none is a search path.
	if grep -rlIF -- "${srcdir}" "${pkgdir}" || grep -rlIF -- "${pkgdir}" "${pkgdir}"; then
		echo "package text files contain build paths" >&2
		return 1
	fi
	# Only distro-independent SCA policy applies to Arch.
	[[ "$(ls "${root}/ruleset/sca")" == sca_distro_independent_linux.yml ]]

	install -Dm0644 "${srcdir}/wazuh-agent.sysusers" "${pkgdir}/usr/lib/sysusers.d/wazuh-agent.conf"
	install -d "${pkgdir}/usr/lib/tmpfiles.d"
	# Recreate directories and empty log files with their owners on every boot,
	# so template sanitising may delete runtime state wholesale.
	awk '
		$1 == "own" {
			if (!($4 in type)) { type[$4] = "z"; mode[$4] = "-"; user[$4] = "root"; group[$4] = "root" }
			if ($2 != "-") user[$4] = $2
			if ($3 != "-") group[$4] = $3
			next
		}
		{ type[$5] = $1; mode[$5] = $2; user[$5] = $3; group[$5] = $4 }
		END {
			for (p in type) {
				if (p == "/var/ossec/etc/client.keys") continue
				if (type[p] == "d" || type[p] == "f" || user[p] != "root" || group[p] != "root")
					printf "%s %s %s %s %s -\n", type[p], p, mode[p], user[p], group[p]
			}
		}' "${log}" | LC_ALL=C sort -k2,2 >"${pkgdir}/usr/lib/tmpfiles.d/wazuh-agent.conf"
	[[ -s "${pkgdir}/usr/lib/tmpfiles.d/wazuh-agent.conf" ]]

	sed 's|WAZUH_HOME_TMP|/var/ossec|g' src/init/templates/wazuh-agent.service \
		| install -Dm0644 /dev/stdin "${pkgdir}/usr/lib/systemd/system/wazuh-agent.service"
	install -d "${pkgdir}/usr/share/wazuh-agent"
	printf '%s\n' "${_commit}" >"${pkgdir}/usr/share/wazuh-agent/source-commit"
	install -Dm0644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
