	'7e9c44e8c7fdb186ff521a8d085b1bfa634d342dcc777ecea1fbf9a98ab5dc5e' # libdb
	'0e971f64bacc22094e89f034bba075b40ecc2c2c2900eecd7ae85815fd6c9f69' # libffi
