# Copy to /etc/srv-orbs.env, owned by root, mode 0600.
# Add AMP_ORB_PROVIDER_TOKEN privately from Amp Settings -> Orbs.
# AMP_ORB_PROVIDER_TOKEN=...
SRV_ORB_ENDPOINT=srv
SRV_ORB_STATE_DIR=/var/lib/srv-orbs/dispatch
SRV_ORB_IMAGE=amp-orb
ORB_IMAGE=amp-orb
SRV_ORB_CPUS=2
SRV_ORB_RAM=4G
SRV_ORB_DISK=20G
# Optional destinations appended to the guest's built-in NO_PROXY list:
# comma-separated hostnames, IPv4 literals, or leading-dot DNS suffixes,
# at most 512 characters including commas; repeats are allowed (not a full
# NO_PROXY string; no CIDR or IPv6 entries). Unset keeps
# the built-in list; setting it requires an updated srv backend and orb
# image, which otherwise reject the extra bootstrap field.
# Update guest agents/images before using repeats or more than eight entries;
# older bypass-capable guests reject those lists after backend admission.
# SRV_ORB_PROXY_BYPASS=.your-tailnet.ts.net,registry.internal
# Only for srv-front, to pin NEW orbs to a host instead of automatic placement:
# SRV_ORB_HOST=a
